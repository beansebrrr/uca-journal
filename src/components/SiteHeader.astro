---
import ThemeSwitcher from "@components/ThemeSwitcher.astro";
---

<header class="site-header">
  <nav>
    <a href="/" class="nav-logo">
      Temploot
    </a>
    <ul class="site-header__nav-list">
      <li><a href="/about">About</a></li>
      <li><a href="/work">Work</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <ThemeSwitcher />
  </nav>
</header>

<style is:global>
  @layer components {
    .site-header {
      padding: var(--space-s) var(--space-s-l);
      container: site-header / inline-size;

      > nav {
        max-width: var(--max-container-width);
        margin-inline: auto;
        display: flex;
        gap: var(--space-2xs) var(--space-m-l);
        place-items: center;
      }

      > nav > ul {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        list-style-type: none;
        padding: 0;
        margin: 0;
        gap: var(--space-xs-s); 
      }
      
      .nav-logo {
        font-size: var(--fs-1);
      }

      .theme-switcher {
        margin-inline-start: auto
      }
    }

    @container site-header (width < 360px) {
      .site-header {

        > nav {
          flex-wrap: wrap;
          gap: var(--space-2xs) var(--space-xs-s);
        }

        > nav > ul {
          order: 10;
          flex: 1 0 100%;
        }
      }
    }
  }
</style>