---
import { SITE, SOCIAlS } from "@utils/consts";
import { Icon } from "astro-icon/components";

---

<footer class="site-footer">
  <nav>
    <div class="site-footer__socials">
      <ul>
        {SOCIAlS.map(social =>
          <li>
            <a href={social.url}>
              {social.iconName && <Icon name={social.iconName}/>}
              {social.platform}
            </a>
          </li>
        )}
      </ul>
    </div>
  </nav>
  <div class="site-footer__bottom">
    <p>Made with :emoji: by {SITE.author.name}</p>
  </div>
</footer>

<style is:global>
  @layer components {  

    .site-footer {
      padding:
        var(--space-s)
        var(--wrapper-pad-inline);
      background: var(--clr-neutral-800);
      color: var(--clr-neutral-100);

      nav ul {
        list-style-type: none;
        padding: 0;

        > li + li {
          margin-block-start: 0.25em;
        }
      }
    }

    .site-footer__socials {
      a > [data-icon] {
        margin-inline-end: var(--space-2xs);
        vertical-align: top;
        height: 1.25em;
      }
    }

    .site-footer__bottom {
      text-align: end;
      margin-block-start: var(--space-2xs);
      font-size: var(--fs--1);
    }
  }
</style>